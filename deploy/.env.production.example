# Copy to deploy/.env.production (gitignored, chmod 600). Never commit secrets.
# Required: real DNS hostname ONLY; no scheme/path, loopback or example domain.
VEEKY_API_HOST=
# Use the tested Git revision/tag. Keep previous image tags for rollback.
VEEKY_IMAGE_TAG=
# Generate once with: openssl rand -hex 32 (hex avoids URL-escaping mistakes).
POSTGRES_PASSWORD=
# Generate once with: openssl rand -base64 32. Keep stable across restarts/services.
LLM_CREDENTIAL_ENCRYPTION_KEY=
# Exact Chrome Web Store extension ID, e.g. ["chrome-extension://<32-letter-id>"]
ALLOWED_CHROME_EXTENSION_ORIGINS=

# Resource quotas default to app/core/settings.py; adjust only after load tests.
# Keep 4-hour max duration. Each X attempt reserves the full 4-hour ASR budget.
MAX_VIDEO_DURATION_SECONDS=14400
MAX_ACTIVE_JOBS_GLOBAL=8
ANALYSIS_LIMIT_GLOBAL_PER_DAY=200
ASR_SECONDS_GLOBAL_PER_DAY=172800
MAX_TEMP_BYTES_GLOBAL=21474836480
MIN_MEDIA_FREE_DISK_BYTES=1073741824
# User Keys are submitted per task, never provisioned as server-wide LLM Keys.
