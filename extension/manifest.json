{
  "manifest_version": 3,
  "minimum_chrome_version": "125",
  "name": "Veeky - AI Agent：YouTube Video Translate & Summarize",
  "version": "0.1.0",
  "description": "读取公开视频字幕，在观看前生成翻译、摘要与时间轴。",
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "webRequest", "webNavigation", "offscreen", "alarms"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://www.youtu.be/*",
    "https://*.x.com/*",
    "https://video.twimg.com/*",
    "https://api.moonshot.cn/*",
    "https://api.deepseek.com/*",
    "https://tokenhub.tencentmaas.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://open.bigmodel.cn/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://cdn-lfs.hf.co/*",
    "https://cdn-lfs-us-1.hf.co/*",
    "https://cdn-lfs-eu-1.hf.co/*",
    "https://cas-bridge.xethub.hf.co/*"
  ],
  "optional_host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://www.youtube.com https://m.youtube.com https://youtube.com https://video.twimg.com https://api.moonshot.cn https://api.deepseek.com https://tokenhub.tencentmaas.com https://dashscope.aliyuncs.com https://open.bigmodel.cn https://huggingface.co https://cdn-lfs.huggingface.co https://cdn-lfs.hf.co https://cdn-lfs-us-1.hf.co https://cdn-lfs-eu-1.hf.co https://cas-bridge.xethub.hf.co http://127.0.0.1:8000 http://localhost:8000"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://www.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/veeky-16.png",
    "32": "icons/veeky-32.png",
    "48": "icons/veeky-48.png",
    "128": "icons/veeky-128.png"
  },
  "action": {
    "default_title": "打开 Veeky",
    "default_icon": {
      "16": "icons/veeky-16.png",
      "32": "icons/veeky-32.png",
      "48": "icons/veeky-48.png",
      "128": "icons/veeky-128.png"
    }
  }
}
