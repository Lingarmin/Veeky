DATABASE_URL=postgresql+asyncpg://youtube_preview:youtube_preview@localhost:5432/youtube_preview
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_VERSION=1.6.5
# Set this when the API and Worker must access YouTube through an HTTP or SOCKS proxy.
# YOUTUBE_TRANSCRIPT_PROXY_URL=http://127.0.0.1:7890
ANALYSIS_PROVIDER_URL=
ANALYSIS_PROVIDER_MODEL=kimi-k2.5
ANALYSIS_PROVIDER_VERSION=v1
ANALYSIS_PROMPT_VERSION=v1
ALLOWED_CHROME_EXTENSION_ORIGINS=["chrome-extension://replace-with-extension-id"]

# Set these only when the corresponding service requires a key.
# LIBRETRANSLATE_API_KEY=
# LLM credentials are entered per user in the extension and are not stored here.
