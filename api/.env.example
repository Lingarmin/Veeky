DATABASE_URL=postgresql+asyncpg://youtube_preview:youtube_preview@localhost:5432/youtube_preview
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
# Required for analysis jobs. Generate with: openssl rand -base64 32
LLM_CREDENTIAL_ENCRYPTION_KEY=
LLM_CREDENTIAL_TTL_SECONDS=3600
ANALYSIS_JOB_LEASE_SECONDS=60
WRITE_RATE_LIMIT_PER_MINUTE=20
READ_RATE_LIMIT_PER_MINUTE=120
MAX_ACTIVE_JOBS_PER_INSTALLATION=1
# Shared admission limits. All daily budgets use a rolling 24-hour window.
# Keep empty for direct access. Trust only the exact reverse proxy addresses.
# Uvicorn must run with --no-proxy-headers (already set in docker-compose.yml).
TRUSTED_PROXY_CIDRS=[]
REGISTRATION_LIMIT_PER_IP_PER_DAY=20
REGISTRATION_LIMIT_GLOBAL_PER_DAY=1000
WRITE_RATE_LIMIT_PER_IP_PER_MINUTE=60
READ_RATE_LIMIT_PER_IP_PER_MINUTE=360
WRITE_RATE_LIMIT_GLOBAL_PER_MINUTE=600
READ_RATE_LIMIT_GLOBAL_PER_MINUTE=3600
MAX_ACTIVE_JOBS_PER_IP=2
MAX_ACTIVE_JOBS_GLOBAL=8
ANALYSIS_LIMIT_PER_IP_PER_DAY=20
ANALYSIS_LIMIT_PER_INSTALLATION_PER_DAY=20
ANALYSIS_LIMIT_GLOBAL_PER_DAY=200
# X ASR reserves the full 4-hour allowance per attempt, not browser-reported duration.
ASR_SECONDS_PER_IP_PER_DAY=28800
ASR_SECONDS_PER_INSTALLATION_PER_DAY=28800
ASR_SECONDS_GLOBAL_PER_DAY=172800
MAX_ACTIVE_MEDIA_UPLOAD_SESSIONS_PER_IP=2
MAX_ACTIVE_MEDIA_UPLOAD_SESSIONS_GLOBAL=8
MEDIA_BYTES_PER_IP_PER_DAY=8589934592
MEDIA_BYTES_PER_INSTALLATION_PER_DAY=8589934592
MEDIA_BYTES_GLOBAL_PER_DAY=42949672960
MAX_TEMP_BYTES_GLOBAL=21474836480
MIN_MEDIA_FREE_DISK_BYTES=1073741824
MAX_VIDEO_DURATION_SECONDS=14400
MAX_MEDIA_BYTES=4294967296
MAX_TEMP_BYTES_PER_JOB=6442450944
MEDIA_CHUNK_BYTES=8388608
MEDIA_TEMP_ROOT=/var/lib/veeky/media
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_MODEL_DIR=/models/whisper
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_VERSION=1.6.5
# Set this when the API and Worker must access YouTube through an HTTP or SOCKS proxy.
# YOUTUBE_TRANSCRIPT_PROXY_URL=http://127.0.0.1:7890
ANALYSIS_PROVIDER_URL=
ANALYSIS_PROVIDER_MODEL=kimi-k2.5
ANALYSIS_PROVIDER_VERSION=v1
ANALYSIS_PROMPT_VERSION=v1
ALLOWED_CHROME_EXTENSION_ORIGINS=["chrome-extension://replace-with-extension-id"]

# Set these only when the corresponding service requires a key.
# LIBRETRANSLATE_API_KEY=
# LLM credentials are entered per user in the extension and are not stored here.
